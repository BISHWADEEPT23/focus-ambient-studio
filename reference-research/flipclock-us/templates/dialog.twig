<div id="{{ id }}" class="dialog_container">
    <div class="{{ id }} dialog">
        <div class="dialog_titlebar">
            <button action="hide_dialog" class="close button button_right">x</button>
            <h2>{{title}}</h2>
        </div>
        <div class="dialog_content">
            {{ content }}
        </div>
    </div>
</div>
